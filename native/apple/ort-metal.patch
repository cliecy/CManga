+#include <cstring>
+#include <mutex>
+
+// Venera's Apple-only runtime: no externally injected or software device can
+// enter the inference context. Keep the selected Dawn adapter's actual name.
+namespace {
+std::mutex venera_metal_mutex;
+std::string venera_metal_name;
+std::string venera_metal_error;
+std::atomic<bool> venera_metal_failed{false};
+void VeneraMetalFailure(std::string message) noexcept {
+  try {
+    std::lock_guard<std::mutex> lock(venera_metal_mutex);
+    if (!venera_metal_failed.load()) venera_metal_error = std::move(message);
+    venera_metal_failed.store(true);
+  } catch (...) {
+    venera_metal_failed.store(true);
+  }
+}
+}
+
+extern "C" __attribute__((visibility("default"))) int VeneraOrtMetalStatus(char* name, size_t name_size,
+                                    char* reason, size_t reason_size) {
+  std::lock_guard<std::mutex> lock(venera_metal_mutex);
+  auto copy = [](char* dest, size_t size, const std::string& text) {
+    if (!dest || !size) return;
+    const size_t count = std::min(size - 1, text.size());
+    std::memcpy(dest, text.data(), count);
+    dest[count] = '\0';
+  };
+  copy(name, name_size, venera_metal_name);
+  copy(reason, reason_size, venera_metal_error);
+  return !venera_metal_name.empty() && !venera_metal_failed.load();
+}
